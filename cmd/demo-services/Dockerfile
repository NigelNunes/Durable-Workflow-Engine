FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/demo-services ./cmd/demo-services

FROM debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /out/demo-services /demo-services
EXPOSE 8081
ENTRYPOINT ["/demo-services"]
